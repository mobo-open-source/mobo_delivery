# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# 32-character AES-256 encryption key used to encrypt the TomTom API key
# stored on the Odoo server. Generate a strong random 32-character string.
# Example: openssl rand -hex 16
ENCRYPTION_KEY="your_32_character_secret_key_here"

# TomTom API key for map tiles, geocoding and routing.
# Get your key at: https://developer.tomtom.com
TOMTOM_API_KEY="your_tomtom_api_key_here"
